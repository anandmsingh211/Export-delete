19:39:48 SQL> -- Description:
19:39:48 SQL> --   Purges PS_* history rows matched via PSARCH tables within a date window.
19:39:48 SQL> --   COMMIT if SELECT count = DELETE rowcount
19:39:48 SQL> -- **********************************************************************
19:39:48 SQL> -- Note: RUN AS SYSADM
19:39:48 SQL> -- HISTORY:
19:39:48 SQL> -- 2025-12-25  Anandmohan Singh  SQL*Plus refactor; test-mode rollbacks
19:39:48 SQL> -- 2026-01-06  Linux-friendly; runtime prompts; no default target DB
19:39:48 SQL> -- **********************************************************************
19:39:48 SQL> 
19:39:48 SQL> -- =========[ Runtime Parameters via command line ]=========
19:39:48 SQL> -- Usage:
19:39:48 SQL> --   sqlplus sysadm/*******@SERVICE @exp_del_val_FS.SQL <DB_NAME> <START_DATE> <END_DATE>
19:39:48 SQL> -- Example:
19:39:48 SQL> --   sqlplus sysadm/*******@FSSNDX    @exp_del_val_FS.SQL FSSNDX 2025-12-01 2025-12-31
19:39:48 SQL> -- Notes:
19:39:48 SQL> --   Dates must be YYYY-MM-DD. End date is inclusive.
19:39:48 SQL> --   Parameter positions: &1=DB_NAME, &2=START_DATE, &3=END_DATE
19:39:48 SQL> 
19:39:48 SQL> define p_target_db = '&1'
Enter value for 1: FSLODX
19:39:52 SQL> define p_start_date = '&2'
Enter value for 2: 2023-05-01
19:40:01 SQL> define p_end_date   = '&3'
Enter value for 3: 2024-03-01
19:40:12 SQL> 
19:40:12 SQL> -- =========[ Variable Block ]=========
19:40:12 SQL> declare
19:40:12   2  	v_current_db   varchar2(30);
19:40:12   3  	v_target_db    varchar2(30) := '&p_target_db';
19:40:12   4  
19:40:12   5  	v_start_ts     timestamp := to_timestamp('&p_start_date','YYYY-MM-DD');
19:40:12   6  	v_end_ts       timestamp := to_timestamp('&p_end_date','YYYY-MM-DD') + interval '1' day;
19:40:12   7  
19:40:12   8  	v_sql	       varchar2(2000);
19:40:12   9  	v_rows	       pls_integer;
19:40:12  10  	v_row_select   pls_integer;
19:40:12  11  	v_total_rows   pls_integer := 0;
19:40:12  12  
19:40:12  13  	-- Stop on first error? (kept TRUE as in your test mode)
19:40:12  14  	c_stop_on_first_error constant boolean := TRUE;
19:40:12  15  
19:40:12  16  	function safe_tbl(rec_name in varchar2) return varchar2 is
19:40:12  17  	begin
19:40:12  18  	  return 'PS_' || dbms_assert.simple_sql_name(rec_name);
19:40:12  19  	end;
19:40:12  20  
19:40:12  21  	procedure log_error(p_tbl in varchar2, p_id in varchar2, p_batch in number) is
19:40:12  22  	begin
19:40:12  23  	  dbms_output.put_line(
19:40:12  24  	    'ERROR on '||p_tbl||
19:40:12  25  	    ' (PSARCH_ID='||p_id||', PSARCH_BATCHNUM='||p_batch||'):'||
19:40:12  26  	    chr(10)||'	SQLERRM: '||sqlerrm||
19:40:12  27  	    chr(10)||'	BACKTRACE: '||dbms_utility.format_error_backtrace
19:40:12  28  	  );
19:40:12  29  	end;
19:40:12  30  
19:40:12  31  begin
19:40:12  32  	select sys_context('USERENV','DB_NAME')
19:40:12  33  	  into v_current_db
19:40:12  34  	  from dual;
19:40:12  35  
19:40:12  36  	if v_current_db <> v_target_db then
19:40:12  37  	  raise_application_error(
19:40:12  38  	    -20001,
19:40:12  39  	    'ABORT: Connected to '||v_current_db||' but target is '||v_target_db
19:40:12  40  	  );
19:40:12  41  	end if;
19:40:12  42  
19:40:12  43  	if v_end_ts <= v_start_ts then
19:40:12  44  	  raise_application_error(-20002,'Invalid date window');
19:40:12  45  	end if;
19:40:12  46  
19:40:12  47  	dbms_output.put_line('Execution DB	: '||v_current_db);
19:40:12  48  	dbms_output.put_line('Date range	: '||
19:40:12  49  			     to_char(v_start_ts,'YYYY-MM-DD')||' .. '||
19:40:12  50  			     to_char(v_end_ts - interval '1' day,'YYYY-MM-DD'));
19:40:12  51  
19:40:12  52  	-- Optional cache flush (requires privileges). Comment out if not granted.
19:40:12  53  	begin
19:40:12  54  	  execute immediate 'alter system flush buffer_cache';
19:40:12  55  	  execute immediate 'alter system flush shared_pool';
19:40:12  56  	exception
19:40:12  57  	  when others then
19:40:12  58  	    dbms_output.put_line('Note: alter system flush skipped: '||sqlerrm);
19:40:12  59  	end;
19:40:12  60  
19:40:12  61  	for r in (
19:40:12  62  	  select distinct
19:40:12  63  		 a.hist_recname,
19:40:12  64  		 b.psarch_id,
19:40:12  65  		 b.psarch_batchnum
19:40:12  66  	    from psarchbatch b
19:40:12  67  	    join psarchtempobj t on b.psarch_id = t.psarch_id
19:40:12  68  	    join psarchobjrec  a on t.psarch_object = a.psarch_object
19:40:12  69  	   where b.psarch_dttm >= v_start_ts
19:40:12  70  	     and b.psarch_dttm <  v_end_ts
19:40:12  71  	)
19:40:12  72  	loop
19:40:12  73  	  declare
19:40:12  74  	    v_tbl varchar2(128) := safe_tbl(r.hist_recname);
19:40:12  75  	  begin
19:40:12  76  	    savepoint one_row;
19:40:12  77  
19:40:12  78  	    ----------------------------------------------------------
19:40:12  79  	    -- SELECT COUNT VALIDATION
19:40:12  80  	    ----------------------------------------------------------
19:40:12  81  	    v_sql := 'select count(*) from '||v_tbl||
19:40:12  82  		     ' where psarch_id = :1 and psarch_batchnum = :2';
19:40:12  83  
19:40:12  84  	    execute immediate v_sql
19:40:12  85  	      into v_row_select
19:40:12  86  	      using r.psarch_id, r.psarch_batchnum;
19:40:12  87  
19:40:12  88  	    ----------------------------------------------------------
19:40:12  89  	    -- DELETE
19:40:12  90  	    ----------------------------------------------------------
19:40:12  91  	    v_sql := 'delete from '||v_tbl||
19:40:12  92  		     ' where psarch_id = :1 and psarch_batchnum = :2';
19:40:12  93  
19:40:12  94  	    execute immediate v_sql
19:40:12  95  	      using r.psarch_id, r.psarch_batchnum;
19:40:12  96  
19:40:12  97  	    v_rows := sql%rowcount;
19:40:12  98  	    v_total_rows := v_total_rows + nvl(v_rows,0);
19:40:12  99  
19:40:12 100  	    ----------------------------------------------------------
19:40:12 101  	    -- COMMIT / ROLLBACK DECISION
19:40:12 102  	    ----------------------------------------------------------
19:40:12 103  	    if v_row_select = v_rows then
19:40:12 104  	      dbms_output.put_line(
19:40:12 105  		'COMMIT | table='||v_tbl||
19:40:12 106  		' | deleted='||v_rows||
19:40:12 107  		' | PSARCH_ID='||r.psarch_id||
19:40:12 108  		' | BATCH='||r.psarch_batchnum
19:40:12 109  	      );
19:40:12 110  	      rollback to savepoint one_row;
19:40:12 111  	    else
19:40:12 112  	      dbms_output.put_line(
19:40:12 113  		'ROLLBACK | MISMATCH | table='||v_tbl||
19:40:12 114  		' | expected='||v_row_select||
19:40:12 115  		' | deleted='||v_rows||
19:40:12 116  		' | PSARCH_ID='||r.psarch_id||
19:40:12 117  		' | BATCH='||r.psarch_batchnum
19:40:12 118  	      );
19:40:12 119  	      rollback to savepoint one_row;
19:40:12 120  
19:40:12 121  	      if c_stop_on_first_error then
19:40:12 122  		raise_application_error(
19:40:12 123  		  -20003,
19:40:12 124  		  'Row count validation failed for '||v_tbl
19:40:12 125  		);
19:40:12 126  	      end if;
19:40:12 127  	    end if;
19:40:12 128  
19:40:12 129  	  exception
19:40:12 130  	    when others then
19:40:12 131  	      rollback to savepoint one_row;
19:40:12 132  	      log_error(v_tbl, r.psarch_id, r.psarch_batchnum);
19:40:12 133  	      if c_stop_on_first_error then
19:40:12 134  		raise;
19:40:12 135  	      end if;
19:40:12 136  	  end;
19:40:12 137  	end loop;
19:40:12 138  
19:40:12 139  	dbms_output.put_line('TOTAL deleted rows committed: '||v_total_rows);
19:40:12 140  
19:40:12 141  end;
19:40:12 142  /
