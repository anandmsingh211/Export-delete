12:10:30 SQL> declare
12:10:30   2  	v_current_db   varchar2(30);
12:10:30   3  	v_target_db    varchar2(30) := '&p_target_db';
12:10:30   4  
12:10:30   5  	-- Convert input dates to timestamps at midnight.
12:10:30   6  	-- End date is inclusive: add 1 day and use < v_end_ts comparison.
12:10:30   7  	v_start_ts     timestamp := to_timestamp('&p_start_date', 'YYYY-MM-DD');		  -- YYYY-MM-DD 00:00:00
12:10:30   8  	v_end_ts       timestamp := to_timestamp('&p_end_date',   'YYYY-MM-DD') + interval '1' day; -- (end + 1 day) 00:00:00
12:10:30   9  
12:10:30  10  	v_sql	       varchar2(2000);
12:10:30  11  	v_rows	       pls_integer;
12:10:30  12  	v_total_rows   pls_integer := 0;
12:10:30  13  
12:10:30  14  	-- Stop on first error? (kept TRUE as in your test mode)
12:10:30  15  	c_stop_on_first_error constant boolean := TRUE;
12:10:30  16  
12:10:30  17  	function safe_tbl(rec_name in varchar2) return varchar2 is
12:10:30  18  	begin
12:10:30  19  	  return 'PS_' || dbms_assert.simple_sql_name(rec_name);
12:10:30  20  	end;
12:10:30  21  
12:10:30  22  	procedure log_error(p_tbl in varchar2, p_id in varchar2, p_batch in number) is
12:10:30  23  	begin
12:10:30  24  	  dbms_output.put_line(
12:10:30  25  	    'ERROR on '||p_tbl||
12:10:30  26  	    ' (PSARCH_ID='||p_id||', PSARCH_BATCHNUM='||p_batch||'):'||
12:10:30  27  	    chr(10)||'	SQLERRM: '||sqlerrm||
12:10:30  28  	    chr(10)||'	BACKTRACE: '||dbms_utility.format_error_backtrace
12:10:30  29  	  );
12:10:30  30  	end;
12:10:30  31  begin
12:10:30  32  	-- Derive current DB at runtime
12:10:30  33  	select sys_context('USERENV','DB_NAME') into v_current_db from dual;
12:10:30  34  
12:10:30  35  	if v_target_db is null then
12:10:30  36  	  raise_application_error(-20000, 'Target DB name is required. Aborting.');
12:10:30  37  	end if;
12:10:30  38  
12:10:30  39  	if v_current_db <> v_target_db then
12:10:30  40  	  dbms_output.put_line('ABORT: DB_NAME='||v_current_db||' != target='||v_target_db);
12:10:30  41  	  return;
12:10:30  42  	end if;
12:10:30  43  
12:10:30  44  	-- Validate date window (after inclusive adjustment)
12:10:30  45  	if v_end_ts <= v_start_ts then
12:10:30  46  	  raise_application_error(-20001, 'End date must be the same or after start date.');
12:10:30  47  	end if;
12:10:30  48  
12:10:30  49  	dbms_output.put_line('TEST MODE: ROLLBACK enabled, stop_on_first_error='||
12:10:30  50  			     case when c_stop_on_first_error then 'TRUE' else 'FALSE' end);
12:10:30  51  	dbms_output.put_line('Window (inclusive dates): '||
12:10:30  52  			     to_char(v_start_ts,'YYYY-MM-DD')||' .. '||
12:10:30  53  			     to_char(v_end_ts - interval '1' day,'YYYY-MM-DD'));
12:10:30  54  	dbms_output.put_line('DB check: current_db='||v_current_db||', target_db='||v_target_db);
12:10:30  55  
12:10:30  56  	-- Optional cache flush (requires privileges). Comment out if not granted.
12:10:30  57  	begin
12:10:30  58  	  execute immediate 'alter system flush buffer_cache';
12:10:30  59  	  execute immediate 'alter system flush shared_pool';
12:10:30  60  	exception
12:10:30  61  	  when others then
12:10:30  62  	    dbms_output.put_line('Note: alter system flush skipped: '||sqlerrm);
12:10:30  63  	end;
12:10:30  64  
12:10:30  65  	for r in (
12:10:30  66  	  select /*+ ORDERED */
12:10:30  67  		 distinct a.hist_recname, b.psarch_batchnum, b.psarch_id
12:10:30  68  	    from psarchbatch b
12:10:30  69  	    join psarchtempobj t on b.psarch_id = t.psarch_id
12:10:30  70  	    join psarchobjrec a  on t.psarch_object = a.psarch_object
12:10:30  71  	   where b.psarch_dttm >= v_start_ts
12:10:30  72  	     and b.psarch_dttm <  v_end_ts
12:10:30  73  	) loop
12:10:30  74  	  declare
12:10:30  75  	    v_tbl varchar2(128) := safe_tbl(r.hist_recname);
12:10:30  76  	  begin
12:10:30  77  	    savepoint one_row;
12:10:30  78  
12:10:30  79  	    v_sql := 'delete from '||v_tbl||
12:10:30  80  		     ' where psarch_id = :1 and psarch_batchnum = :2';
12:10:30  81  	    execute immediate v_sql using r.psarch_id, r.psarch_batchnum;
12:10:30  82  
12:10:30  83  	    v_rows := sql%rowcount;
12:10:30  84  	    v_total_rows := v_total_rows + nvl(v_rows,0);
12:10:30  85  
12:10:30  86  	    dbms_output.put_line('Deleted |'||v_rows||'| rows from |'||v_tbl||
12:10:30  87  				 '| for (PSARCH_ID= |'||r.psarch_id||
12:10:30  88  				 ',| PSARCH_BATCHNUM= |'||r.psarch_batchnum||'|).');
12:10:30  89  
12:10:30  90  	    -- TEST MODE: rollback this iteration
12:10:30  91  	    rollback to savepoint one_row;
12:10:30  92  
12:10:30  93  	  exception
12:10:30  94  	    when others then
12:10:30  95  	      rollback to savepoint one_row;
12:10:30  96  	      log_error(v_tbl, r.psarch_id, r.psarch_batchnum);
12:10:30  97  
12:10:30  98  	      if c_stop_on_first_error then
12:10:30  99  		raise;
12:10:30 100  	      end if;
12:10:30 101  	  end;
12:10:30 102  	end loop;
12:10:30 103  
12:10:30 104  	dbms_output.put_line('TOTAL rows (attempted deletes, rolled back): '||v_total_rows);
12:10:30 105  
12:10:30 106  	-- TEST MODE: rollback entire session
12:10:30 107  	rollback;
12:10:30 108  
12:10:30 109  end;
