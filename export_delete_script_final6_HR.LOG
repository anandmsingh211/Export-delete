12:33:14  67  		 distinct a.hist_recname, b.psarch_batchnum, b.psarch_id
12:33:14  68  	    from psarchbatch b
12:33:14  69  	    join psarchtempobj t on b.psarch_id = t.psarch_id
12:33:14  70  	    join psarchobjrec a  on t.psarch_object = a.psarch_object
12:33:14  71  	   where b.psarch_dttm >= v_start_ts
12:33:14  72  	     and b.psarch_dttm <  v_end_ts
12:33:14  73  	) loop
