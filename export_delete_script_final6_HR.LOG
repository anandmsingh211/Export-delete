12:33:14  23  	begin
12:33:14  24  	  dbms_output.put_line(
12:33:14  25  	    'ERROR on '||p_tbl||
12:33:14  26  	    ' (PSARCH_ID='||p_id||', PSARCH_BATCHNUM='||p_batch||'):'||
