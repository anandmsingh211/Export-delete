12:33:14  76  	  begin
12:33:14  77  	    savepoint one_row;
12:33:14  78  
12:33:14  79  	    v_sql := 'delete from '||v_tbl||
12:33:14  80  		     ' where psarch_id = :1 and psarch_batchnum = :2';
12:33:14  81  	    execute immediate v_sql using r.psarch_id, r.psarch_batchnum;
12:33:14  82  
12:33:14  83  	    v_rows := sql%rowcount;
12:33:14  84  	    v_total_rows := v_total_rows + nvl(v_rows,0);
12:33:14  85  
12:33:14  86  	    dbms_output.put_line('Deleted |'||v_rows||'| rows from |'||v_tbl||
12:33:14  87  				 '| for (PSARCH_ID= |'||r.psarch_id||
12:33:14  88  				 ',| PSARCH_BATCHNUM= |'||r.psarch_batchnum||'|).');
12:33:14  89  
