03:16:25 SQL> DECLARE
03:16:25   2  	v_target_db    CONSTANT VARCHAR2(30) := 'FSSNDX';
03:16:25   3  	v_current_db   VARCHAR2(30);
03:16:25   4  
03:16:25   5  	v_sql	       VARCHAR2(2000);
03:16:25   6  
03:16:25   7  	v_start_ts     CONSTANT TIMESTAMP := TIMESTAMP '2023-05-01 00:00:00';
03:16:25   8  	v_end_ts       CONSTANT TIMESTAMP := TIMESTAMP '2024-03-02 00:00:00';
03:16:25   9  
03:16:25  10  	FUNCTION safe_tbl(rec_name IN VARCHAR2) RETURN VARCHAR2 IS
03:16:25  11  	BEGIN
03:16:25  12  	  RETURN 'PS_' || DBMS_ASSERT.SIMPLE_SQL_NAME(rec_name);
03:16:25  13  	END;
03:16:25  14  BEGIN
03:16:25  15  	SELECT SYS_CONTEXT('USERENV','DB_NAME') INTO v_current_db FROM dual;
03:16:25  16  	IF v_current_db <> v_target_db THEN
03:16:25  17  	  RETURN; -- Abort if wrong DB
03:16:25  18  	END IF;
03:16:25  19  
03:16:25  20  	FOR r IN (
03:16:25  21  	  SELECT R.HIST_RECNAME, B.PSARCH_BATCHNUM, B.PSARCH_ID
03:16:25  22  	    FROM PSARCHBATCH B
03:16:25  23  	    JOIN PSARCHTEMPOBJ T ON B.PSARCH_ID = T.PSARCH_ID
03:16:25  24  	    JOIN PSARCHOBJREC R  ON T.PSARCH_OBJECT = R.PSARCH_OBJECT
03:16:25  25  	   WHERE B.PSARCH_DTTM >= v_start_ts
03:16:25  26  	     AND B.PSARCH_DTTM <  v_end_ts
03:16:25  27  	) LOOP
03:16:25  28  	  DECLARE
03:16:25  29  	    v_tbl VARCHAR2(128) := safe_tbl(r.HIST_RECNAME);
03:16:25  30  	  BEGIN
03:16:25  31  	    SAVEPOINT one_row;
03:16:25  32  
03:16:25  33  	    v_sql := 'DELETE FROM ' || v_tbl || ' WHERE PSARCH_ID = :1 AND PSARCH_BATCHNUM = :2';
03:16:25  34  	    EXECUTE IMMEDIATE v_sql USING r.PSARCH_ID, r.PSARCH_BATCHNUM;
03:16:25  35  
03:16:25  36  	    -- TEST MODE: rollback this iteration
03:16:25  37  	    -- COMMIT; -- <-- In PROD, commit here
03:16:25  38  	    ROLLBACK TO SAVEPOINT one_row;
03:16:25  39  
03:16:25  40  	  EXCEPTION
03:16:25  41  	    WHEN OTHERS THEN
03:16:25  42  	      ROLLBACK TO SAVEPOINT one_row;
03:16:25  43  	  END;
03:16:25  44  	END LOOP;
03:16:25  45  
03:16:25  46  	-- TEST MODE: rollback entire session
03:16:25  47  	-- COMMIT; -- <-- In PROD, final commit here
03:16:25  48  	ROLLBACK;
03:16:25  49  
03:16:25  50  EXCEPTION
03:16:25  51  	WHEN OTHERS THEN
03:16:25  52  	  ROLLBACK;
03:16:25  53  END;
