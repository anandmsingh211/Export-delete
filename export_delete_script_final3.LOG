03:18:36 SQL> DECLARE
03:18:36   2  	v_target_db    CONSTANT VARCHAR2(30) := 'FSSNDX';
03:18:36   3  	v_current_db   VARCHAR2(30);
03:18:36   4  
03:18:36   5  	v_sql	       VARCHAR2(2000);
03:18:36   6  
03:18:36   7  	v_start_ts     CONSTANT TIMESTAMP := TIMESTAMP '2023-05-01 00:00:00';
03:18:36   8  	v_end_ts       CONSTANT TIMESTAMP := TIMESTAMP '2024-03-02 00:00:00';
03:18:36   9  
03:18:36  10  	v_total_rows   NUMBER := 0;
03:18:36  11  
03:18:36  12  	FUNCTION safe_tbl(rec_name IN VARCHAR2) RETURN VARCHAR2 IS
03:18:36  13  	BEGIN
03:18:36  14  	  RETURN 'PS_' || DBMS_ASSERT.SIMPLE_SQL_NAME(rec_name);
03:18:36  15  	END;
03:18:36  16  BEGIN
03:18:36  17  	SELECT SYS_CONTEXT('USERENV','DB_NAME') INTO v_current_db FROM dual;
03:18:36  18  	IF v_current_db <> v_target_db THEN
03:18:36  19  	  DBMS_OUTPUT.PUT_LINE('ABORT: Wrong DB. Expected='||v_target_db||' got='||v_current_db);
03:18:36  20  	  RETURN;
03:18:36  21  	END IF;
03:18:36  22  
03:18:36  23  	FOR r IN (
03:18:36  24  	  SELECT R.HIST_RECNAME, B.PSARCH_BATCHNUM, B.PSARCH_ID
03:18:36  25  	    FROM PSARCHBATCH B
03:18:36  26  	    JOIN PSARCHTEMPOBJ T ON B.PSARCH_ID = T.PSARCH_ID
03:18:36  27  	    JOIN PSARCHOBJREC R  ON T.PSARCH_OBJECT = R.PSARCH_OBJECT
03:18:36  28  	   WHERE B.PSARCH_DTTM >= v_start_ts
03:18:36  29  	     AND B.PSARCH_DTTM <  v_end_ts
03:18:36  30  	) LOOP
03:18:36  31  	  DECLARE
03:18:36  32  	    v_tbl	 VARCHAR2(128) := safe_tbl(r.HIST_RECNAME);
03:18:36  33  	    v_rows	 NUMBER;
03:18:36  34  	  BEGIN
03:18:36  35  	    SAVEPOINT one_row;
03:18:36  36  
03:18:36  37  	    v_sql := 'DELETE FROM ' || v_tbl || ' WHERE PSARCH_ID = :1 AND PSARCH_BATCHNUM = :2';
03:18:36  38  	    EXECUTE IMMEDIATE v_sql USING r.PSARCH_ID, r.PSARCH_BATCHNUM;
03:18:36  39  	    v_rows := SQL%ROWCOUNT;
03:18:36  40  	    v_total_rows := v_total_rows + v_rows;
03:18:36  41  
03:18:36  42  	    DBMS_OUTPUT.PUT_LINE(
03:18:36  43  	      TO_CHAR(SYSTIMESTAMP,'YYYY-MM-DD HH24:MI:SS.FF3')
03:18:36  44  	      || ' TABLE='||v_tbl
03:18:36  45  	      || ' PSARCH_ID='||r.PSARCH_ID
03:18:36  46  	      || ' PSARCH_BATCHNUM='||r.PSARCH_BATCHNUM
03:18:36  47  	      || ' ROWS_DELETED='||NVL(v_rows,0)
03:18:36  48  	      || ' (TEST MODE—rolled back)'
03:18:36  49  	    );
03:18:36  50  
03:18:36  51  	    -- TEST MODE: undo this iteration
03:18:36  52  	    ROLLBACK TO SAVEPOINT one_row;
03:18:36  53  
03:18:36  54  	  EXCEPTION
03:18:36  55  	    WHEN OTHERS THEN
03:18:36  56  	      DBMS_OUTPUT.PUT_LINE(
03:18:36  57  		TO_CHAR(SYSTIMESTAMP,'YYYY-MM-DD HH24:MI:SS.FF3')
03:18:36  58  		|| ' TABLE='||v_tbl
03:18:36  59  		|| ' PSARCH_ID='||r.PSARCH_ID
03:18:36  60  		|| ' PSARCH_BATCHNUM='||r.PSARCH_BATCHNUM
03:18:36  61  		|| ' ERROR='||SQLERRM
03:18:36  62  	      );
03:18:36  63  	      ROLLBACK TO SAVEPOINT one_row;
03:18:36  64  	  END;
03:18:36  65  	END LOOP;
03:18:36  66  
03:18:36  67  	DBMS_OUTPUT.PUT_LINE('---------------------------------------------');
03:18:36  68  	DBMS_OUTPUT.PUT_LINE(
03:18:36  69  	  TO_CHAR(SYSTIMESTAMP,'YYYY-MM-DD HH24:MI:SS.FF3')
03:18:36  70  	  || ' TOTAL_ROWS_DELETED='||NVL(v_total_rows,0)
03:18:36  71  	  || ' (TEST MODE—rolled back)'
03:18:36  72  	);
03:18:36  73  	DBMS_OUTPUT.PUT_LINE('---------------------------------------------');
03:18:36  74  
03:18:36  75  	-- TEST MODE final rollback
03:18:36  76  	ROLLBACK;
03:18:36  77  
03:18:36  78  EXCEPTION
03:18:36  79  	WHEN OTHERS THEN
03:18:36  80  	  DBMS_OUTPUT.PUT_LINE('BLOCK ERROR='||SQLERRM);
03:18:36  81  	  ROLLBACK;
03:18:36  82  END;
03:18:36  83  /
