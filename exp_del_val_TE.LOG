19:29:09 SQL> -- Description:
19:29:09 SQL> --   Purges PS_* history rows matched via PSARCH tables within a date window.
19:29:09 SQL> --   COMMIT if SELECT count = DELETE rowcount
19:29:09 SQL> -- **********************************************************************
19:29:09 SQL> -- Note: RUN AS SYSADM
19:29:09 SQL> -- HISTORY:
19:29:09 SQL> -- 2025-12-25  Anandmohan Singh  SQL*Plus refactor; test-mode rollbacks
19:29:09 SQL> -- 2026-01-06  Linux-friendly; runtime prompts; no default target DB
19:29:09 SQL> -- **********************************************************************
19:29:09 SQL> 
19:29:09 SQL> -- =========[ Runtime Parameters via command line ]=========
19:29:09 SQL> -- Usage:
19:29:09 SQL> --   sqlplus sysadm/*******@SERVICE @exp_del_val_TE.SQL <DB_NAME> <START_DATE> <END_DATE>
19:29:09 SQL> -- Example:
19:29:09 SQL> --   sqlplus sysadm/*******@FSSNDX    @exp_del_val_TE.SQL TESNDX 2025-12-01 2025-12-31
19:29:09 SQL> -- Notes:
19:29:09 SQL> --   Dates must be YYYY-MM-DD. End date is inclusive.
19:29:09 SQL> --   Parameter positions: &1=DB_NAME, &2=START_DATE, &3=END_DATE
19:29:09 SQL> 
19:29:09 SQL> define p_target_db = '&1'
Enter value for 1: TELODX
19:29:13 SQL> define p_start_date = '&2'
Enter value for 2: 2023-05-01
19:29:26 SQL> define p_end_date   = '&3'
Enter value for 3: 2024-03-01
19:29:35 SQL> 
19:29:35 SQL> -- =========[ Variable Block ]=========
19:29:35 SQL> declare
19:29:35   2  	v_current_db   varchar2(30);
19:29:35   3  	v_target_db    varchar2(30) := '&p_target_db';
19:29:35   4  
19:29:35   5  	v_start_ts     timestamp := to_timestamp('&p_start_date','YYYY-MM-DD');
19:29:35   6  	v_end_ts       timestamp := to_timestamp('&p_end_date','YYYY-MM-DD') + interval '1' day;
19:29:35   7  
19:29:35   8  	v_sql	       varchar2(2000);
19:29:35   9  	v_rows	       pls_integer;
19:29:35  10  	v_row_select   pls_integer;
19:29:35  11  	v_total_rows   pls_integer := 0;
19:29:35  12  
19:29:35  13  	-- Stop on first error? (kept TRUE as in your test mode)
19:29:35  14  	c_stop_on_first_error constant boolean := TRUE;
19:29:35  15  
19:29:35  16  	function safe_tbl(rec_name in varchar2) return varchar2 is
19:29:35  17  	begin
19:29:35  18  	  return 'PS_' || dbms_assert.simple_sql_name(rec_name);
19:29:35  19  	end;
19:29:35  20  
19:29:35  21  	procedure log_error(p_tbl in varchar2, p_id in varchar2, p_batch in number) is
19:29:35  22  	begin
19:29:35  23  	  dbms_output.put_line(
19:29:35  24  	    'ERROR on '||p_tbl||
19:29:35  25  	    ' (PSARCH_ID='||p_id||', PSARCH_BATCHNUM='||p_batch||'):'||
19:29:35  26  	    chr(10)||'	SQLERRM: '||sqlerrm||
19:29:35  27  	    chr(10)||'	BACKTRACE: '||dbms_utility.format_error_backtrace
19:29:35  28  	  );
19:29:35  29  	end;
19:29:35  30  
19:29:35  31  begin
19:29:35  32  	select sys_context('USERENV','DB_NAME')
19:29:35  33  	  into v_current_db
19:29:35  34  	  from dual;
19:29:35  35  
19:29:35  36  	if v_current_db <> v_target_db then
19:29:35  37  	  raise_application_error(
19:29:35  38  	    -20001,
19:29:35  39  	    'ABORT: Connected to '||v_current_db||' but target is '||v_target_db
19:29:35  40  	  );
19:29:35  41  	end if;
19:29:35  42  
19:29:35  43  	if v_end_ts <= v_start_ts then
19:29:35  44  	  raise_application_error(-20002,'Invalid date window');
19:29:35  45  	end if;
19:29:35  46  
19:29:35  47  	dbms_output.put_line('Execution DB	: '||v_current_db);
19:29:35  48  	dbms_output.put_line('Date range	: '||
19:29:35  49  			     to_char(v_start_ts,'YYYY-MM-DD')||' .. '||
19:29:35  50  			     to_char(v_end_ts - interval '1' day,'YYYY-MM-DD'));
19:29:35  51  
19:29:35  52  	-- Optional cache flush (requires privileges). Comment out if not granted.
19:29:35  53  	begin
19:29:35  54  	  execute immediate 'alter system flush buffer_cache';
19:29:35  55  	  execute immediate 'alter system flush shared_pool';
19:29:35  56  	exception
19:29:35  57  	  when others then
19:29:35  58  	    dbms_output.put_line('Note: alter system flush skipped: '||sqlerrm);
19:29:35  59  	end;
19:29:35  60  
19:29:35  61  	for r in (
19:29:35  62  	  select distinct
19:29:35  63  		 a.hist_recname,
19:29:35  64  		 b.psarch_id,
19:29:35  65  		 b.psarch_batchnum
19:29:35  66  	    from psarchbatch b
19:29:35  67  	    join psarchtempobj t on b.psarch_id = t.psarch_id
19:29:35  68  	    join psarchobjrec  a on t.psarch_object = a.psarch_object
19:29:35  69  	   where b.psarch_dttm >= v_start_ts
19:29:35  70  	     and b.psarch_dttm <  v_end_ts
19:29:35  71  	)
19:29:35  72  	loop
19:29:35  73  	  declare
19:29:35  74  	    v_tbl varchar2(128) := safe_tbl(r.hist_recname);
19:29:35  75  	  begin
19:29:35  76  	    savepoint one_row;
19:29:35  77  
19:29:35  78  	    ----------------------------------------------------------
19:29:35  79  	    -- SELECT COUNT VALIDATION
19:29:35  80  	    ----------------------------------------------------------
19:29:35  81  	    v_sql := 'select count(*) from '||v_tbl||
19:29:35  82  		     ' where psarch_id = :1 and psarch_batchnum = :2';
19:29:35  83  
19:29:35  84  	    execute immediate v_sql
19:29:35  85  	      into v_row_select
19:29:35  86  	      using r.psarch_id, r.psarch_batchnum;
19:29:35  87  
19:29:35  88  	    ----------------------------------------------------------
19:29:35  89  	    -- DELETE
19:29:35  90  	    ----------------------------------------------------------
19:29:35  91  	    v_sql := 'delete from '||v_tbl||
19:29:35  92  		     ' where psarch_id = :1 and psarch_batchnum = :2';
19:29:35  93  
19:29:35  94  	    execute immediate v_sql
19:29:35  95  	      using r.psarch_id, r.psarch_batchnum;
19:29:35  96  
19:29:35  97  	    v_rows := sql%rowcount;
19:29:35  98  	    v_total_rows := v_total_rows + nvl(v_rows,0);
19:29:35  99  
19:29:35 100  	    ----------------------------------------------------------
19:29:35 101  	    -- COMMIT / ROLLBACK DECISION
19:29:35 102  	    ----------------------------------------------------------
19:29:35 103  	    if v_row_select = v_rows then
19:29:35 104  	      dbms_output.put_line(
19:29:35 105  		'COMMIT | table='||v_tbl||
19:29:35 106  		' | deleted='||v_rows||
19:29:35 107  		' | PSARCH_ID='||r.psarch_id||
19:29:35 108  		' | BATCH='||r.psarch_batchnum
19:29:35 109  	      );
19:29:35 110  	      rollback to savepoint one_row;
19:29:35 111  	    else
19:29:35 112  	      dbms_output.put_line(
19:29:35 113  		'ROLLBACK | MISMATCH | table='||v_tbl||
19:29:35 114  		' | expected='||v_row_select||
19:29:35 115  		' | deleted='||v_rows||
19:29:35 116  		' | PSARCH_ID='||r.psarch_id||
19:29:35 117  		' | BATCH='||r.psarch_batchnum
19:29:35 118  	      );
19:29:35 119  	      rollback to savepoint one_row;
19:29:35 120  
19:29:35 121  	      if c_stop_on_first_error then
19:29:35 122  		raise_application_error(
19:29:35 123  		  -20003,
19:29:35 124  		  'Row count validation failed for '||v_tbl
19:29:35 125  		);
19:29:35 126  	      end if;
19:29:35 127  	    end if;
19:29:35 128  
19:29:35 129  	  exception
19:29:35 130  	    when others then
19:29:35 131  	      rollback to savepoint one_row;
19:29:35 132  	      log_error(v_tbl, r.psarch_id, r.psarch_batchnum);
19:29:35 133  	      if c_stop_on_first_error then
19:29:35 134  		raise;
19:29:35 135  	      end if;
19:29:35 136  	  end;
19:29:35 137  	end loop;
19:29:35 138  
19:29:35 139  	dbms_output.put_line('TOTAL deleted rows committed: '||v_total_rows);
19:29:35 140  
19:29:35 141  end;
