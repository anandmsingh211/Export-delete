07:03:52 SQL> DECLARE
07:03:52   2  	v_target_db    CONSTANT VARCHAR2(30) := 'FSSNDX';
07:03:52   3  	v_current_db   VARCHAR2(30);
07:03:52   4  
07:03:52   5  	v_sql	       VARCHAR2(2000);
07:03:52   6  	v_rows	       PLS_INTEGER;
07:03:52   7  	v_total_rows   PLS_INTEGER := 0;
07:03:52   8  
07:03:52   9  	-- Toggle: stop immediately on first error (TRUE) or continue (FALSE)
07:03:52  10  	c_stop_on_first_error CONSTANT BOOLEAN := TRUE;
07:03:52  11  
07:03:52  12  	v_start_ts     CONSTANT TIMESTAMP := TIMESTAMP '2023-05-01 00:00:00';
07:03:52  13  	v_end_ts       CONSTANT TIMESTAMP := TIMESTAMP '2024-03-02 00:00:00';
07:03:52  14  
07:03:52  15  	FUNCTION safe_tbl(rec_name IN VARCHAR2) RETURN VARCHAR2 IS
07:03:52  16  	BEGIN
07:03:52  17  	  RETURN 'PS_' || DBMS_ASSERT.SIMPLE_SQL_NAME(rec_name);
07:03:52  18  	END;
07:03:52  19  
07:03:52  20  	PROCEDURE log_error(p_tbl IN VARCHAR2, p_id IN VARCHAR2, p_batch IN NUMBER) IS
07:03:52  21  	BEGIN
07:03:52  22  	  DBMS_OUTPUT.PUT_LINE(
07:03:52  23  	    'ERROR on '||p_tbl||
07:03:52  24  	    ' (PSARCH_ID='||p_id||', PSARCH_BATCHNUM='||p_batch||'):'||
07:03:52  25  	    CHR(10)||'	SQLERRM: '||SQLERRM||
07:03:52  26  	    CHR(10)||'	BACKTRACE: '||DBMS_UTILITY.FORMAT_ERROR_BACKTRACE
07:03:52  27  	  );
07:03:52  28  	END;
07:03:52  29  
07:03:52  30  BEGIN
07:03:52  31  	SELECT SYS_CONTEXT('USERENV','DB_NAME') INTO v_current_db FROM dual;
07:03:52  32  	IF v_current_db <> v_target_db THEN
07:03:52  33  	  DBMS_OUTPUT.PUT_LINE('ABORT: DB_NAME='||v_current_db||' != '||v_target_db);
07:03:52  34  	  RETURN;
07:03:52  35  	END IF;
07:03:52  36  
07:03:52  37  	DBMS_OUTPUT.PUT_LINE('TEST MODE: ROLLBACK enabled, stop_on_first_error='||
07:03:52  38  			     CASE WHEN c_stop_on_first_error THEN 'TRUE' ELSE 'FALSE' END);
07:03:52  39  	DBMS_OUTPUT.PUT_LINE('Window: '||TO_CHAR(v_start_ts,'YYYY-MM-DD HH24:MI:SS')||
07:03:52  40  			     ' .. '||TO_CHAR(v_end_ts,'YYYY-MM-DD HH24:MI:SS'));
07:03:52  41  
07:03:52  42  	FOR r IN (
07:03:52  43  	  SELECT /*+ ORDERED */
07:03:52  44  		 DISTINCT R.HIST_RECNAME, B.PSARCH_BATCHNUM, B.PSARCH_ID
07:03:52  45  	    FROM PSARCHBATCH B
07:03:52  46  	    JOIN PSARCHTEMPOBJ T ON B.PSARCH_ID = T.PSARCH_ID
07:03:52  47  	    JOIN PSARCHOBJREC R  ON T.PSARCH_OBJECT = R.PSARCH_OBJECT
07:03:52  48  	   WHERE B.PSARCH_DTTM >= v_start_ts
07:03:52  49  	     AND B.PSARCH_DTTM <  v_end_ts
07:03:52  50  	) LOOP
07:03:52  51  	  DECLARE
07:03:52  52  	    v_tbl VARCHAR2(128) := safe_tbl(r.HIST_RECNAME);
07:03:52  53  	  BEGIN
07:03:52  54  	    SAVEPOINT one_row;
07:03:52  55  
07:03:52  56  	    v_sql := 'DELETE FROM '||v_tbl||
07:03:52  57  		     ' WHERE PSARCH_ID = :1 AND PSARCH_BATCHNUM = :2';
07:03:52  58  	    EXECUTE IMMEDIATE v_sql USING r.PSARCH_ID, r.PSARCH_BATCHNUM;
07:03:52  59  
07:03:52  60  	    v_rows := SQL%ROWCOUNT;
07:03:52  61  	    v_total_rows := v_total_rows + NVL(v_rows,0);
07:03:52  62  
07:03:52  63  	    DBMS_OUTPUT.PUT_LINE('Deleted '||v_rows||' rows from '||v_tbl||
07:03:52  64  				 ' for (PSARCH_ID='||r.PSARCH_ID||
07:03:52  65  				 ', PSARCH_BATCHNUM='||r.PSARCH_BATCHNUM||').');
07:03:52  66  
07:03:52  67  	    -- TEST MODE: rollback this iteration
07:03:52  68  	    ROLLBACK TO SAVEPOINT one_row;
07:03:52  69  
07:03:52  70  	  EXCEPTION
07:03:52  71  	    WHEN OTHERS THEN
07:03:52  72  	      -- Always rollback the iteration in test mode
07:03:52  73  	      ROLLBACK TO SAVEPOINT one_row;
07:03:52  74  	      -- Log details
07:03:52  75  	      log_error(v_tbl, r.PSARCH_ID, r.PSARCH_BATCHNUM);
07:03:52  76  
07:03:52  77  	      IF c_stop_on_first_error THEN
07:03:52  78  		-- Re-raise so the outer block aborts and SQL*Plus WHENEVER SQLERROR triggers
07:03:52  79  		RAISE;
07:03:52  80  	      END IF;
07:03:52  81  	      -- Else: continue to next iteration
07:03:52  82  	  END;
07:03:52  83  	END LOOP;
07:03:52  84  
07:03:52  85  	DBMS_OUTPUT.PUT_LINE('TOTAL rows (attempted deletes, rolled back): '||v_total_rows);
07:03:52  86  
07:03:52  87  	-- TEST MODE: rollback entire session
07:03:52  88  	ROLLBACK;
07:03:52  89  
07:03:52  90  EXCEPTION
07:03:52  91  	WHEN OTHERS THEN
07:03:52  92  	  -- Final safeguard + clear diagnostics
07:03:52  93  	  ROLLBACK;
07:03:52  94  	  DBMS_OUTPUT.PUT_LINE('FATAL: '||SQLERRM);
07:03:52  95  	  DBMS_OUTPUT.PUT_LINE('BACKTRACE: '||DBMS_UTILITY.FORMAT_ERROR_BACKTRACE);
07:03:52  96  	  -- Re-raise so SQL*Plus can exit with failure (honors WHENEVER SQLERROR EXIT FAILURE ROLLBACK)
07:03:52  97  	  RAISE;
07:03:52  98  END;
07:03:52  99  /
