19:42:04 SQL> -- Description:
19:42:04 SQL> --   Purges PS_* history rows matched via PSARCH tables within a date window.
19:42:04 SQL> --   COMMIT if SELECT count = DELETE rowcount
19:42:04 SQL> -- **********************************************************************
19:42:04 SQL> -- Note: RUN AS SYSADM
19:42:04 SQL> -- HISTORY:
19:42:04 SQL> -- 2025-12-25  Anandmohan Singh  SQL*Plus refactor; test-mode rollbacks
19:42:04 SQL> -- 2026-01-06  Linux-friendly; runtime prompts; no default target DB
19:42:04 SQL> -- **********************************************************************
19:42:04 SQL> 
19:42:04 SQL> -- =========[ Runtime Parameters via command line ]=========
19:42:04 SQL> -- Usage:
19:42:04 SQL> --   sqlplus sysadm/*******@SERVICE @exp_del_val_HR.SQL <DB_NAME> <START_DATE> <END_DATE>
19:42:04 SQL> -- Example:
19:42:04 SQL> --   sqlplus sysadm/*******@FSSNDX    @exp_del_val_HR.SQL HRSNDX 2025-12-01 2025-12-31
19:42:04 SQL> -- Notes:
19:42:04 SQL> --   Dates must be YYYY-MM-DD. End date is inclusive.
19:42:04 SQL> --   Parameter positions: &1=DB_NAME, &2=START_DATE, &3=END_DATE
19:42:04 SQL> 
19:42:04 SQL> define p_target_db = '&1'
Enter value for 1: HRLODX
19:42:09 SQL> define p_start_date = '&2'
Enter value for 2: 2023-05-01
19:42:27 SQL> define p_end_date   = '&3'
Enter value for 3: 2024-03-01
19:42:36 SQL> 
19:42:36 SQL> -- =========[ Variable Block ]=========
19:42:36 SQL> declare
19:42:36   2  	v_current_db   varchar2(30);
19:42:36   3  	v_target_db    varchar2(30) := '&p_target_db';
19:42:36   4  
19:42:36   5  	v_start_ts     timestamp := to_timestamp('&p_start_date','YYYY-MM-DD');
19:42:36   6  	v_end_ts       timestamp := to_timestamp('&p_end_date','YYYY-MM-DD') + interval '1' day;
19:42:36   7  
19:42:36   8  	v_sql	       varchar2(2000);
19:42:36   9  	v_rows	       pls_integer;
19:42:36  10  	v_row_select   pls_integer;
19:42:36  11  	v_total_rows   pls_integer := 0;
19:42:36  12  
19:42:36  13  	-- Stop on first error? (kept TRUE as in your test mode)
19:42:36  14  	c_stop_on_first_error constant boolean := TRUE;
19:42:36  15  
19:42:36  16  	function safe_tbl(rec_name in varchar2) return varchar2 is
19:42:36  17  	begin
19:42:36  18  	  return 'PS_' || dbms_assert.simple_sql_name(rec_name);
19:42:36  19  	end;
19:42:36  20  
19:42:36  21  	procedure log_error(p_tbl in varchar2, p_id in varchar2, p_batch in number) is
19:42:36  22  	begin
19:42:36  23  	  dbms_output.put_line(
19:42:36  24  	    'ERROR on '||p_tbl||
19:42:36  25  	    ' (PSARCH_ID='||p_id||', PSARCH_BATCHNUM='||p_batch||'):'||
19:42:36  26  	    chr(10)||'	SQLERRM: '||sqlerrm||
19:42:36  27  	    chr(10)||'	BACKTRACE: '||dbms_utility.format_error_backtrace
19:42:36  28  	  );
19:42:36  29  	end;
19:42:36  30  
19:42:36  31  begin
19:42:36  32  	select sys_context('USERENV','DB_NAME')
19:42:36  33  	  into v_current_db
19:42:36  34  	  from dual;
19:42:36  35  
19:42:36  36  	if v_current_db <> v_target_db then
19:42:36  37  	  raise_application_error(
19:42:36  38  	    -20001,
19:42:36  39  	    'ABORT: Connected to '||v_current_db||' but target is '||v_target_db
19:42:36  40  	  );
19:42:36  41  	end if;
19:42:36  42  
19:42:36  43  	if v_end_ts <= v_start_ts then
19:42:36  44  	  raise_application_error(-20002,'Invalid date window');
19:42:36  45  	end if;
19:42:36  46  
19:42:36  47  	dbms_output.put_line('Execution DB	: '||v_current_db);
19:42:36  48  	dbms_output.put_line('Date range	: '||
19:42:36  49  			     to_char(v_start_ts,'YYYY-MM-DD')||' .. '||
19:42:36  50  			     to_char(v_end_ts - interval '1' day,'YYYY-MM-DD'));
19:42:36  51  
19:42:36  52  	-- Optional cache flush (requires privileges). Comment out if not granted.
19:42:36  53  	begin
19:42:36  54  	  execute immediate 'alter system flush buffer_cache';
19:42:36  55  	  execute immediate 'alter system flush shared_pool';
19:42:36  56  	exception
19:42:36  57  	  when others then
19:42:36  58  	    dbms_output.put_line('Note: alter system flush skipped: '||sqlerrm);
19:42:36  59  	end;
19:42:36  60  
19:42:36  61  	for r in (
19:42:36  62  	  select distinct
19:42:36  63  		 a.hist_recname,
19:42:36  64  		 b.psarch_id,
19:42:36  65  		 b.psarch_batchnum
19:42:36  66  	    from psarchbatch b
19:42:36  67  	    join psarchtempobj t on b.psarch_id = t.psarch_id
19:42:36  68  	    join psarchobjrec  a on t.psarch_object = a.psarch_object
19:42:36  69  	   where b.psarch_dttm >= v_start_ts
19:42:36  70  	     and b.psarch_dttm <  v_end_ts
19:42:36  71  	)
19:42:36  72  	loop
19:42:36  73  	  declare
19:42:36  74  	    v_tbl varchar2(128) := safe_tbl(r.hist_recname);
19:42:36  75  	  begin
19:42:36  76  	    savepoint one_row;
19:42:36  77  
19:42:36  78  	    ----------------------------------------------------------
19:42:37  79  	    -- SELECT COUNT VALIDATION
19:42:37  80  	    ----------------------------------------------------------
19:42:37  81  	    v_sql := 'select count(*) from '||v_tbl||
19:42:37  82  		     ' where psarch_id = :1 and psarch_batchnum = :2';
19:42:37  83  
19:42:37  84  	    execute immediate v_sql
19:42:37  85  	      into v_row_select
19:42:37  86  	      using r.psarch_id, r.psarch_batchnum;
19:42:37  87  
19:42:37  88  	    ----------------------------------------------------------
19:42:37  89  	    -- DELETE
19:42:37  90  	    ----------------------------------------------------------
19:42:37  91  	    v_sql := 'delete from '||v_tbl||
19:42:37  92  		     ' where psarch_id = :1 and psarch_batchnum = :2';
19:42:37  93  
19:42:37  94  	    execute immediate v_sql
19:42:37  95  	      using r.psarch_id, r.psarch_batchnum;
19:42:37  96  
19:42:37  97  	    v_rows := sql%rowcount;
19:42:37  98  	    v_total_rows := v_total_rows + nvl(v_rows,0);
19:42:37  99  
19:42:37 100  	    ----------------------------------------------------------
19:42:37 101  	    -- COMMIT / ROLLBACK DECISION
19:42:37 102  	    ----------------------------------------------------------
19:42:37 103  	    if v_row_select = v_rows then
19:42:37 104  	      dbms_output.put_line(
19:42:37 105  		'COMMIT | table='||v_tbl||
19:42:37 106  		' | deleted='||v_rows||
19:42:37 107  		' | PSARCH_ID='||r.psarch_id||
19:42:37 108  		' | BATCH='||r.psarch_batchnum
19:42:37 109  	      );
19:42:37 110  	      rollback to savepoint one_row;
19:42:37 111  	    else
19:42:37 112  	      dbms_output.put_line(
19:42:37 113  		'ROLLBACK | MISMATCH | table='||v_tbl||
19:42:37 114  		' | expected='||v_row_select||
19:42:37 115  		' | deleted='||v_rows||
19:42:37 116  		' | PSARCH_ID='||r.psarch_id||
19:42:37 117  		' | BATCH='||r.psarch_batchnum
19:42:37 118  	      );
19:42:37 119  	      rollback to savepoint one_row;
19:42:37 120  
19:42:37 121  	      if c_stop_on_first_error then
19:42:37 122  		raise_application_error(
19:42:37 123  		  -20003,
19:42:37 124  		  'Row count validation failed for '||v_tbl
19:42:37 125  		);
19:42:37 126  	      end if;
19:42:37 127  	    end if;
19:42:37 128  
19:42:37 129  	  exception
19:42:37 130  	    when others then
19:42:37 131  	      rollback to savepoint one_row;
19:42:37 132  	      log_error(v_tbl, r.psarch_id, r.psarch_batchnum);
19:42:37 133  	      if c_stop_on_first_error then
19:42:37 134  		raise;
19:42:37 135  	      end if;
19:42:37 136  	  end;
19:42:37 137  	end loop;
19:42:37 138  
19:42:37 139  	dbms_output.put_line('TOTAL deleted rows committed: '||v_total_rows);
19:42:37 140  
19:42:37 141  end;
19:42:37 142  /
