19:43:11 SQL> -- Description:
19:43:11 SQL> --   Purges PS_* history rows matched via PSARCH tables within a date window.
19:43:11 SQL> --   COMMIT if SELECT count = DELETE rowcount
19:43:11 SQL> -- **********************************************************************
19:43:11 SQL> -- Note: RUN AS SYSADM
19:43:11 SQL> -- HISTORY:
19:43:11 SQL> -- 2025-12-25  Anandmohan Singh  SQL*Plus refactor; test-mode rollbacks
19:43:11 SQL> -- 2026-01-06  Linux-friendly; runtime prompts; no default target DB
19:43:11 SQL> -- **********************************************************************
19:43:11 SQL> 
19:43:11 SQL> -- =========[ Runtime Parameters via command line ]=========
19:43:11 SQL> -- Usage:
19:43:11 SQL> --   sqlplus sysadm/*******@SERVICE @exp_del_val_SE.SQL <DB_NAME> <START_DATE> <END_DATE>
19:43:11 SQL> -- Example:
19:43:11 SQL> --   sqlplus sysadm/*******@FSSNDX    @exp_del_val_SE.SQL SESNDX 2025-12-01 2025-12-31
19:43:11 SQL> -- Notes:
19:43:11 SQL> --   Dates must be YYYY-MM-DD. End date is inclusive.
19:43:11 SQL> --   Parameter positions: &1=DB_NAME, &2=START_DATE, &3=END_DATE
19:43:11 SQL> 
19:43:11 SQL> define p_target_db = '&1'
Enter value for 1: SELODX
19:43:14 SQL> define p_start_date = '&2'
Enter value for 2: 2023-05-01
19:43:23 SQL> define p_end_date   = '&3'
Enter value for 3: 2024-03-01
19:43:31 SQL> 
19:43:31 SQL> -- =========[ Variable Block ]=========
19:43:31 SQL> declare
19:43:31   2  	v_current_db   varchar2(30);
19:43:31   3  	v_target_db    varchar2(30) := '&p_target_db';
19:43:31   4  
19:43:31   5  	v_start_ts     timestamp := to_timestamp('&p_start_date','YYYY-MM-DD');
19:43:31   6  	v_end_ts       timestamp := to_timestamp('&p_end_date','YYYY-MM-DD') + interval '1' day;
19:43:31   7  
19:43:31   8  	v_sql	       varchar2(2000);
19:43:31   9  	v_rows	       pls_integer;
19:43:31  10  	v_row_select   pls_integer;
19:43:31  11  	v_total_rows   pls_integer := 0;
19:43:31  12  
19:43:31  13  	-- Stop on first error? (kept TRUE as in your test mode)
19:43:31  14  	c_stop_on_first_error constant boolean := TRUE;
19:43:31  15  
19:43:31  16  	function safe_tbl(rec_name in varchar2) return varchar2 is
19:43:31  17  	begin
19:43:31  18  	  return 'PS_' || dbms_assert.simple_sql_name(rec_name);
19:43:31  19  	end;
19:43:31  20  
19:43:31  21  	procedure log_error(p_tbl in varchar2, p_id in varchar2, p_batch in number) is
19:43:31  22  	begin
19:43:31  23  	  dbms_output.put_line(
19:43:31  24  	    'ERROR on '||p_tbl||
19:43:31  25  	    ' (PSARCH_ID='||p_id||', PSARCH_BATCHNUM='||p_batch||'):'||
19:43:31  26  	    chr(10)||'	SQLERRM: '||sqlerrm||
19:43:31  27  	    chr(10)||'	BACKTRACE: '||dbms_utility.format_error_backtrace
19:43:31  28  	  );
19:43:31  29  	end;
19:43:31  30  
19:43:31  31  begin
19:43:31  32  	select sys_context('USERENV','DB_NAME')
19:43:31  33  	  into v_current_db
19:43:31  34  	  from dual;
19:43:31  35  
19:43:31  36  	if v_current_db <> v_target_db then
19:43:31  37  	  raise_application_error(
19:43:31  38  	    -20001,
19:43:31  39  	    'ABORT: Connected to '||v_current_db||' but target is '||v_target_db
19:43:31  40  	  );
19:43:31  41  	end if;
19:43:31  42  
19:43:31  43  	if v_end_ts <= v_start_ts then
19:43:31  44  	  raise_application_error(-20002,'Invalid date window');
19:43:31  45  	end if;
19:43:31  46  
19:43:31  47  	dbms_output.put_line('Execution DB	: '||v_current_db);
19:43:31  48  	dbms_output.put_line('Date range	: '||
19:43:31  49  			     to_char(v_start_ts,'YYYY-MM-DD')||' .. '||
19:43:31  50  			     to_char(v_end_ts - interval '1' day,'YYYY-MM-DD'));
19:43:31  51  
19:43:31  52  	-- Optional cache flush (requires privileges). Comment out if not granted.
19:43:31  53  	begin
19:43:31  54  	  execute immediate 'alter system flush buffer_cache';
19:43:31  55  	  execute immediate 'alter system flush shared_pool';
19:43:31  56  	exception
19:43:31  57  	  when others then
19:43:31  58  	    dbms_output.put_line('Note: alter system flush skipped: '||sqlerrm);
19:43:31  59  	end;
19:43:31  60  
19:43:31  61  	for r in (
19:43:31  62  	  select distinct
19:43:31  63  		 a.hist_recname,
19:43:31  64  		 b.psarch_id,
19:43:31  65  		 b.psarch_batchnum
19:43:31  66  	    from psarchbatch b
19:43:31  67  	    join psarchtempobj t on b.psarch_id = t.psarch_id
19:43:31  68  	    join psarchobjrec  a on t.psarch_object = a.psarch_object
19:43:31  69  	   where b.psarch_dttm >= v_start_ts
19:43:31  70  	     and b.psarch_dttm <  v_end_ts
19:43:31  71  	)
19:43:31  72  	loop
19:43:31  73  	  declare
19:43:31  74  	    v_tbl varchar2(128) := safe_tbl(r.hist_recname);
19:43:31  75  	  begin
19:43:31  76  	    savepoint one_row;
19:43:31  77  
19:43:31  78  	    ----------------------------------------------------------
19:43:31  79  	    -- SELECT COUNT VALIDATION
19:43:31  80  	    ----------------------------------------------------------
19:43:31  81  	    v_sql := 'select count(*) from '||v_tbl||
19:43:31  82  		     ' where psarch_id = :1 and psarch_batchnum = :2';
19:43:31  83  
19:43:31  84  	    execute immediate v_sql
19:43:31  85  	      into v_row_select
19:43:31  86  	      using r.psarch_id, r.psarch_batchnum;
19:43:31  87  
19:43:31  88  	    ----------------------------------------------------------
19:43:31  89  	    -- DELETE
19:43:31  90  	    ----------------------------------------------------------
19:43:31  91  	    v_sql := 'delete from '||v_tbl||
19:43:31  92  		     ' where psarch_id = :1 and psarch_batchnum = :2';
19:43:31  93  
19:43:31  94  	    execute immediate v_sql
19:43:31  95  	      using r.psarch_id, r.psarch_batchnum;
19:43:31  96  
19:43:31  97  	    v_rows := sql%rowcount;
19:43:31  98  	    v_total_rows := v_total_rows + nvl(v_rows,0);
19:43:31  99  
19:43:31 100  	    ----------------------------------------------------------
19:43:31 101  	    -- COMMIT / ROLLBACK DECISION
19:43:31 102  	    ----------------------------------------------------------
19:43:31 103  	    if v_row_select = v_rows then
19:43:31 104  	      dbms_output.put_line(
19:43:31 105  		'COMMIT | table='||v_tbl||
19:43:31 106  		' | deleted='||v_rows||
19:43:31 107  		' | PSARCH_ID='||r.psarch_id||
19:43:31 108  		' | BATCH='||r.psarch_batchnum
19:43:31 109  	      );
19:43:31 110  	      rollback to savepoint one_row;
19:43:31 111  	    else
19:43:31 112  	      dbms_output.put_line(
19:43:31 113  		'ROLLBACK | MISMATCH | table='||v_tbl||
19:43:31 114  		' | expected='||v_row_select||
19:43:31 115  		' | deleted='||v_rows||
19:43:31 116  		' | PSARCH_ID='||r.psarch_id||
19:43:31 117  		' | BATCH='||r.psarch_batchnum
19:43:31 118  	      );
19:43:31 119  	      rollback to savepoint one_row;
19:43:31 120  
19:43:31 121  	      if c_stop_on_first_error then
19:43:31 122  		raise_application_error(
19:43:31 123  		  -20003,
19:43:31 124  		  'Row count validation failed for '||v_tbl
19:43:31 125  		);
19:43:31 126  	      end if;
19:43:31 127  	    end if;
19:43:31 128  
19:43:31 129  	  exception
19:43:31 130  	    when others then
19:43:31 131  	      rollback to savepoint one_row;
19:43:31 132  	      log_error(v_tbl, r.psarch_id, r.psarch_batchnum);
19:43:31 133  	      if c_stop_on_first_error then
19:43:31 134  		raise;
19:43:31 135  	      end if;
19:43:31 136  	  end;
19:43:31 137  	end loop;
19:43:31 138  
19:43:31 139  	dbms_output.put_line('TOTAL deleted rows committed: '||v_total_rows);
19:43:31 140  
19:43:31 141  end;
